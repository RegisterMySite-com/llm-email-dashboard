{
  "name": "llm-email-dashboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "email-studio",
      "database_id": "REPLACE_AT_PROVISION"
    }
  ],
  "ai": { "binding": "AI" },
  "send_email": [{ "name": "EMAIL" }],
  "observability": { "enabled": true },
  "vars": {
    "ROOT_DOMAIN": "example.com",
    "DEFAULT_FROM": "hello@example.com",
    "ALLOWED_SENDERS": "hello@example.com",
    "ADMIN_EMAILS": "",
    "PLATFORM": "registermysite.com",
    "TEMPLATE_REPO": "RegisterMySite-com/llm-email-dashboard"
  }
}
